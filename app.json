{
  "expo": {
    "name": "Cooperstown All Star Village",
    "slug": "cooperstown-experience",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cooperstown",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.utproducts.cooperstown",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "associatedDomains": [],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.utproducts.cooperstown",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Cooperstown All Star Village",
      "shortName": "All Star Village",
      "themeColor": "#0E2340",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Directors use the camera to scan player check-in QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8102E"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Staff choose photos of the park, the site map and products to show families.",
          "cameraPermission": "Staff take photos of the park and products to show families."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows where you are on the park map so you can find your field, parking, food and restrooms.",
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}
