{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "demo": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DEMO": "1",
        "EXPO_PUBLIC_APP_URL": "https://utproducts.github.io/Cooperstown-experience/demo"
      }
    }
  },
  "submit": {
    "production": {},
    "demo": {}
  }
}
